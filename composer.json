{
	"name": "theapiguysdev/zsoogi-clipper",
	"description": "Admin-only Zsoogi Clips with a modern jQuery-free bookmarklet for web research",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.7",
		"wp-coding-standards/wpcs": "^3.0",
		"phpcsstandards/phpcsextra": "^1.0",
		"phpcsstandards/phpcsutils": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"Zsoogi\\": "includes/"
		}
	},
	"scripts": {
		"install-standards": [
			"vendor/bin/phpcs --config-set installed_paths vendor/wp-coding-standards/wpcs,vendor/phpcsstandards/phpcsextra,vendor/phpcsstandards/phpcsutils"
		],
		"post-install-cmd": [
			"@install-standards"
		],
		"post-update-cmd": [
			"@install-standards"
		],
		"lint": "vendor/bin/phpcs",
		"lint-fix": "vendor/bin/phpcbf",
		"build-zip": "bash build.sh"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
