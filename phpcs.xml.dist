<?xml version="1.0"?>
<ruleset name="API Zsoogi Clips PHPCS Configuration">
    <description>PHPCS configuration for API Zsoogi Clips plugin using WordPress Coding Standards</description>

    <!-- Show colors and progress -->
    <arg name="colors"/>
    <arg value="ps"/>

    <!-- Check all PHP files in the plugin directory -->
    <file>.</file>

    <!-- Exclude vendor, node_modules, and build directories -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>

    <!-- Use WordPress Coding Standards -->
    <rule ref="WordPress"/>
</ruleset>
